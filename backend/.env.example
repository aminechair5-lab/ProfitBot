# Generate a unique long random secret. Never commit the real .env file.
OWNER_API_TOKEN=replace-with-a-long-random-secret
# Use managed PostgreSQL for cloud persistence. SQLite is for local development only.
DATABASE_URL=sqlite:///./profitbot.db
CORS_ORIGINS=http://localhost

# Payment provider: sandbox is the default. Set live only after PayPal merchant approval.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# CJ Dropshipping: API key stays server-side. Live order creation needs an additional
# per-request owner confirmation; CJ supplier payments are not performed by ProfitBot.
CJ_API_KEY=
CJ_LIVE_ORDER_CREATION=false

# 17TRACK shipment tracking
TRACK17_API_KEY=

# Optional email notifications (SMTP). Leave blank to keep notifications disabled.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
